// Copy this file to secrets.h and fill in your values.
// NEVER commit secrets.h (it is gitignored).
//
// Two provisioning paths:
//
// PRODUCTION (dynamic, recommended): leave BOX_ID and DEVICE_KEY as "".
// Power the box, hold the '*' key for 5 s, join its
// "SafeDrop-Setup" Wi-Fi, and enter your home Wi-Fi + the claim code from
// the app (Settings > Pair a new box) at http://192.168.4.1.
// No reflashing needed ever again — config lives in EEPROM.
//
// PROTOTYPE (hard-coded): fill in BOX_ID and DEVICE_KEY below with the
// values shown once at pairing time, then flash.

#define WIFI_SSID ""  // optional: pre-fill your Wi-Fi name
#define WIFI_PASS ""  // optional: pre-fill your Wi-Fi password

// Your deployed server, e.g. "safedrop.vercel.app" (no https://, no trailing slash)
#define SERVER_HOST "your-app.vercel.app"

// Leave both empty ("") for dynamic provisioning; paste values for the
// hard-coded prototype path.
#define BOX_ID ""
#define DEVICE_KEY ""
